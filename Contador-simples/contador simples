algoritmo "contador"

var
  contador: inteiro

inicio
  // o contador recebe o número 1 para começar
  contador <- 1
  // equanto esse número for menor ou igual a 10 ele irá mostrar na tela
  enquanto (contador <= 10 ) faca
  escreval(contador)
    contador <- contador + 1
  fimenquanto

fimalgoritmo
